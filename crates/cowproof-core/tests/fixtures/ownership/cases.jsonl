# Ownership parity cases. Capture against the Node reference with:
#   PORTKIT_CAPTURE=1 PORTKIT_ADAPTER_CMD="node <adapter>" cargo test -p cowproof-core --test ownership_parity -- --ignored
# Globs are compared by behaviour: each case lists probe paths and the result is one match flag per probe.
# glob_to_regex runs the Rust regex source through the regex crate; glob_matches runs the matcher.
# removed-lines-removed-text-starts-dashes carries an accepted difference on /count (Node bug, Rust correct; ruling P4-R1).
# Not a case: the same file in two diff blocks (Node sums them, Rust counts the first). Not applicable, git never emits it (ruling P4-R1).
{"tool":"glob_to_regex","id":"glob-star-star","input":{"glob":"**","probe":["a","b/c","d/e/f",".env",""]},"note":"** matches everything, including nested paths"}
{"tool":"glob_to_regex","id":"glob-star-star-slash","input":{"glob":"**/test","probe":["test","a/test","a/b/test","test.md","atest"]},"note":"**/ matches zero or more directories; the slash is consumed so a bare suffix also matches"}
{"tool":"glob_to_regex","id":"glob-star-star-slash-mid","input":{"glob":"a/**/b","probe":["a/b","a/x/b","a/x/y/b","a/xb","ab"]},"note":"**/ in the middle"}
{"tool":"glob_to_regex","id":"glob-star-star-leading","input":{"glob":"**/test.rs","probe":["test.rs","a/test.rs","a/b/test.rs","atest.rs"]},"note":"** at start"}
{"tool":"glob_to_regex","id":"glob-trailing-star-star","input":{"glob":"a/**","probe":["a","a/","a/b","a/b/c/d","ab","b/a/c"]},"note":"trailing /** needs the slash"}
{"tool":"glob_to_regex","id":"glob-trailing-star-star-docs","input":{"glob":"docs/**","probe":["docs/a","docs/a/b","docs","docs/"]},"note":"docs/** matches everything below docs"}
{"tool":"glob_to_regex","id":"glob-star-star-inline","input":{"glob":"a**b","probe":["ab","axb","a/x/b","a/b"]},"note":"** without slashes is a greedy any-text"}
{"tool":"glob_to_regex","id":"glob-star-star-star","input":{"glob":"***","probe":["a","a/b"]},"note":"three stars: ** then *"}
{"tool":"glob_to_regex","id":"glob-star-star-pair","input":{"glob":"**/**","probe":["a","a/b",""]},"note":"** pairs"}
{"tool":"glob_to_regex","id":"glob-star-star-twice","input":{"glob":"a/**/**/b","probe":["a/b","a/x/b","a/x/y/b"]},"note":"two ** segments"}
{"tool":"glob_to_regex","id":"glob-four-stars-slash","input":{"glob":"****/x","probe":["x","a/x","ax"]},"note":"four stars is two ** pairs"}
{"tool":"glob_to_regex","id":"glob-single-star","input":{"glob":"*","probe":["a","a/b","",".hidden"]},"note":"* alone does not cross /"}
{"tool":"glob_to_regex","id":"glob-star-ext","input":{"glob":"*.md","probe":["a.md","c/d.md",".md","md","a.mdx"]},"note":"* does not cross /"}
{"tool":"glob_to_regex","id":"glob-star-start","input":{"glob":"*test.rs","probe":["test.rs","atest.rs","a/test.rs"]},"note":"* at start"}
{"tool":"glob_to_regex","id":"glob-star-in-middle","input":{"glob":"a*/b","probe":["a/b","abc/b","a/b/c","a/x/b"]},"note":"* in the middle"}
{"tool":"glob_to_regex","id":"glob-multiple-stars","input":{"glob":"a*b*c","probe":["abc","aXbYc","a/b/c","aXb/c"]},"note":"several single stars"}
{"tool":"glob_to_regex","id":"glob-star-segment","input":{"glob":"src/*/test.rs","probe":["src/a/test.rs","src/a/b/test.rs","test.rs","src/test.rs"]},"note":"one directory level"}
{"tool":"glob_to_regex","id":"glob-complex-docs","input":{"glob":"docs/**/*.md","probe":["docs/a.md","docs/a/b.md","docs/a/b/c.md","docs.md","a/docs/b.md","docs/a.txt"]},"note":"nested directories then an extension"}
{"tool":"glob_to_regex","id":"glob-question","input":{"glob":"a?b","probe":["aXb","ab","a/b","acb","aXYb"]},"note":"? matches one character but not /"}
{"tool":"glob_to_regex","id":"glob-question-only","input":{"glob":"?","probe":["a","/","ab",""]},"note":"single ? alone"}
{"tool":"glob_to_regex","id":"glob-question-pair","input":{"glob":"a??b","probe":["aXYb","aXb","ab","aX/b","a/Xb"]},"note":"two ?"}
{"tool":"glob_to_regex","id":"glob-question-slash","input":{"glob":"a?b","probe":["a/b"]},"note":"? never matches /"}
{"tool":"glob_to_regex","id":"glob-dot-meta","input":{"glob":"a.b","probe":["a.b","axb","a/b"]},"note":". is literal"}
{"tool":"glob_to_regex","id":"glob-plus-meta","input":{"glob":"a+b","probe":["a+b","aab","ab"]},"note":"+ is literal"}
{"tool":"glob_to_regex","id":"glob-paren-meta","input":{"glob":"a(b)c","probe":["a(b)c","abc","a/b/c"]},"note":"() is literal"}
{"tool":"glob_to_regex","id":"glob-bracket-meta","input":{"glob":"a[b]c","probe":["a[b]c","abc","a/b/c"]},"note":"[] is literal, not a character class"}
{"tool":"glob_to_regex","id":"glob-brace-meta","input":{"glob":"a{1,2}b","probe":["a{1,2}b","a1b","a11b","ab"]},"note":"{} is literal, not a quantifier"}
{"tool":"glob_to_regex","id":"glob-brace-alt","input":{"glob":"a{b,c}","probe":["a{b,c}","ab","ac"]},"note":"{a,b} is not alternation"}
{"tool":"glob_to_regex","id":"glob-dollar-meta","input":{"glob":"a$b","probe":["a$b","ab"]},"note":"$ is literal"}
{"tool":"glob_to_regex","id":"glob-caret-meta","input":{"glob":"a^b","probe":["a^b","ab"]},"note":"^ is literal"}
{"tool":"glob_to_regex","id":"glob-pipe-meta","input":{"glob":"a|b","probe":["a|b","a","b","ab"]},"note":"| is literal, not alternation"}
{"tool":"glob_to_regex","id":"glob-backslash-meta","input":{"glob":"a\\b","probe":["a\\b","ab","a/b"]},"note":"backslash is literal"}
{"tool":"glob_to_regex","id":"glob-backslash-star","input":{"glob":"a\\*","probe":["a\\b","a\\","a*","a"]},"note":"backslash does not escape the star"}
{"tool":"glob_to_regex","id":"glob-dollar-end","input":{"glob":"a.md$","probe":["a.md$","a.md","a.mdx"]},"note":"trailing $ is literal"}
{"tool":"glob_to_regex","id":"glob-all-meta","input":{"glob":".+^${}()|[]\\/","probe":[".+^${}()|[]\\/","x"]},"note":"every escaped metacharacter together"}
{"tool":"glob_to_regex","id":"glob-env-star","input":{"glob":".env*","probe":[".env",".env.local",".env.test","env","a/.env",".envrc"]},"note":".env* at the repository root"}
{"tool":"glob_to_regex","id":"glob-env-dot-star","input":{"glob":".env.*","probe":[".env",".env.local",".envrc","a/.env.local"]},"note":".env.* needs the second dot"}
{"tool":"glob_to_regex","id":"glob-env-nested","input":{"glob":"**/.env","probe":[".env","a/.env","a/b/.env","x.env","a/.env.local"]},"note":"**/.env at any depth"}
{"tool":"glob_to_regex","id":"glob-empty","input":{"glob":"","probe":["","a","/"]},"note":"empty glob matches only the empty string"}
{"tool":"glob_to_regex","id":"glob-slash-only","input":{"glob":"/","probe":["/","a/b","a"]},"note":"a lone slash"}
{"tool":"glob_to_regex","id":"glob-leading-slash","input":{"glob":"/a","probe":["/a","a","//a"]},"note":"leading slash is literal"}
{"tool":"glob_to_regex","id":"glob-trailing-slash","input":{"glob":"a/","probe":["a/","a","a//"]},"note":"trailing slash is literal"}
{"tool":"glob_to_regex","id":"glob-double-slash","input":{"glob":"a//b","probe":["a/b","a//b"]},"note":"consecutive slashes are literal"}
{"tool":"glob_to_regex","id":"glob-unicode-star","input":{"glob":"é*","probe":["éa","e","é","é/a"]},"note":"non-ASCII literal followed by *"}
{"tool":"glob_to_regex","id":"glob-unicode-question","input":{"glob":"a?b","probe":["aéb","a/b"]},"note":"? matches one non-ASCII character"}
{"tool":"glob_to_regex","id":"glob-space","input":{"glob":"a b/*.md","probe":["a b/c.md","ab/c.md","a b/c/d.md"]},"note":"spaces are literal"}
{"tool":"glob_to_regex","id":"glob-dash-dot","input":{"glob":"a-b.c","probe":["a-b.c","a-bxc"]},"note":"hyphen and dot"}
{"tool":"glob_to_regex","id":"glob-hash-amp","input":{"glob":"a#b&c~d","probe":["a#b&c~d","a#b&c","abc"]},"note":"characters that are special in some regex dialects"}
